# API Configuration
EXPO_PUBLIC_API_URL=https://baseurl.com

# Google Maps — used by app.config.js at BUILD TIME to embed native API keys
GOOGLE_MAP_API_KEY=mapkey

# Google Maps — used at RUNTIME for client-side Places Autocomplete in the app
# Must have EXPO_PUBLIC_ prefix to be available in the JS bundle
EXPO_PUBLIC_GOOGLE_MAP_API_KEY=mapkey

# Development Credentials (auto-filled only in __DEV__ mode)
EXPO_PUBLIC_DEV_EMAIL=user@example.com
EXPO_PUBLIC_DEV_PASSWORD=password123


# AdMob Configuration
EXPO_PUBLIC_ADMOB_TEST_MODE=false
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=ca-app-pub-
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-

EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-
EXPO_PUBLIC_ADMOB_IOS_BANNER=ca-app-pub-
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=ca-app-pub-
