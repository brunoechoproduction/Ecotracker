{
  "expo": {
    "name": "EcoTrackr",
    "slug": "EcoTrackr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/Icon.png",
    "scheme": "ecotrackr",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/icons/Icon.png",
      "bundleIdentifier": "com.syntaxel.EcoTracker",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyCfQzt_oUOcgLamzpPSrGRILECUtN9GZ4Y"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "This app requires tracking permission to deliver personalized ads to support eco-friendly initiatives.",
        "NSLocationWhenInUseUsageDescription": "Allow EcoTrackr to use your location to discover eco-friendly stays and challenges near you.",
        "NSPhotoLibraryUsageDescription": "Allow EcoTrackr to access your photos to upload proof of your completed challenges.",
        "NSCameraUsageDescription": "Allow EcoTrackr to access your camera to take photos of your eco-friendly activities."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icons/Icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.syntaxel.EcoTracker",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBOq3EO_1wKdV4nnULrkPo6V-t-QkuT4P0"
        }
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "com.google.android.gms.permission.AD_ID",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.NFC",
        "android.permission.BODY_SENSORS",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CALL_LOG",
        "android.permission.WRITE_CALL_LOG",
        "android.permission.SEND_SMS",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow EcoTrackr to use your location to discover eco-friendly stays and challenges near you."
        }
      ],
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyCfQzt_oUOcgLamzpPSrGRILECUtN9GZ4Y",
          "androidGoogleMapsApiKey": "AIzaSyBOq3EO_1wKdV4nnULrkPo6V-t-QkuT4P0"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16A34A",
          "image": "./assets/icons/transparent.png",
          "android": {
            "image": "./assets/icons/transparent.png",
            "imageWidth": 0,
            "backgroundImage": "./assets/icons/splash_background.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EcoTrackr to access your photos to upload proof of your completed challenges.",
          "cameraPermission": "Allow EcoTrackr to access your camera to take photos of your eco-friendly activities."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7914769443576357~5076957034",
          "iosAppId": "ca-app-pub-7914769443576357~2670551476"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This app requires tracking permission to deliver personalized ads to support eco-friendly initiatives."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "397cf027-f154-4e04-8805-794955288291"
      }
    }
  }
}
